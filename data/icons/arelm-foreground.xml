<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground layer, hand-authored directly as an Android
  VectorDrawable rather than run through pixiewood's SVG->AVD conversion
  (`Svg2Avd`, see pixiewood's `generate` step) - that conversion needs jar
  files out of a full Android Studio install (pixiewood's
  android-studio-dir option), which this build deliberately avoids.
  pixiewood's `type="avd"` drawable handling
  (see `pixiewood` script, `handle_drawable`) just copies a file like this
  one in verbatim, so a hand-written AVD works exactly the same as a
  Svg2Avd-converted one, no Android Studio required.

  108x108dp canvas per Android's adaptive icon spec, artwork kept inside the
  ~66dp safe zone (a circle outline + "+"/"-" glyphs, echoing
  arelm's counter UI) so it isn't clipped by the launcher's icon mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M84,54 A30,30 0 1,1 24,54 A30,30 0 1,1 84,54 Z"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4"/>
    <path
        android:pathData="M34,40 L46,40 M40,34 L40,46"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"/>
    <path
        android:pathData="M62,70 L74,70"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"/>
</vector>
