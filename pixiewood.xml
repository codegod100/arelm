<?xml version="1.0" encoding="UTF-8"?>
<!--
  pixiewood manifest for arelm - see gtk-android-builder's "Pixiewood
  Format" docs (https://github.com/sp1ritCS/gtk-android-builder#pixiewood-format)
  and pixiewood.xsd for the schema this follows.

  Build with (on a machine that has the Android SDK/NDK and meson >=1.9
  installed - see README.md; Android Studio is *not* required, despite
  gtk-android-builder's own docs listing it as a prerequisite):
    pixiewood prepare -s "$ANDROID_HOME" pixiewood.xml
    pixiewood generate
    pixiewood build
-->
<app xmlns="https://sp1rit.arpa/pixiewood/" xmlns:xi="http://www.w3.org/2001/XInclude">
	<metainfo vercalc="count">
		<!--
			The metainfo file itself is produced inside the build directory
			by meson.build's `configure_file()` call, from
			data/com.example.Arelm.metainfo.xml - see the comment there for
			why it has to be a build product rather than a plain src:// path.

			The leading path segment after `build://` picks which per-arch
			build dir (.pixiewood/bin-<arch>) pixiewood resolves this from -
			it's a real arch name, not a template variable (the gtk-android-
			builder README's "{arch}" in its own example is the same doc
			placeholder convention as its neighboring
			"{path/to/(localized)/appstream/manifest.xml}", not literal
			syntax pixiewood substitutes). Content is identical between
			architectures here, so any one of the built archs works.
		-->
		<xi:include href="build://aarch64/com.example.Arelm.metainfo.xml" parse="xml"/>
	</metainfo>
	<style>
		<!-- Adwaita theme + libadwaita wrap. gtk-android-builder ships both
		     (`theme name="adw"` and prepare/wraps/libadwaita); the
		     no-appstream patch is required so the wrap builds without a
		     cross-compiled appstream. -->
		<theme name="adw"/>
		<icon type="generate">
			<!-- Hand-authored Android VectorDrawables, not SVG - type="avd"
			     drawables are copied verbatim by pixiewood (no Svg2Avd
			     conversion), so this needs no Android Studio install. See
			     the comments in data/icons/arelm-foreground.xml. -->
			<drawable target="foreground" type="avd" path="src://data/icons/arelm-foreground.xml"/>
			<color target="background">#1e1b4b</color>
			<drawable target="monochrome" type="avd" path="src://data/icons/arelm-monochrome.xml"/>
		</icon>
	</style>
	<dependencies>
		<glib>
			<patch>hack</patch>
		</glib>
		<fontconfig/>
		<gtk/>
		<libadwaita>
			<patch>no-appstream</patch>
		</libadwaita>
	</dependencies>
	<build target="arelm">
		<!-- Must match the name of the custom_target() in meson.build -->
		<architectures>
			<arch>aarch64</arch>
			<arch>x86_64</arch>
		</architectures>
	</build>
</app>
