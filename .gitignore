/target/
/builddir/
/build/

# pixiewood's own working directory: per-arch meson build dirs
# (.pixiewood/bin-*), the generated Android Studio/Gradle project
# (.pixiewood/android), and the installed sysroot (.pixiewood/root) all get
# regenerated by `pixiewood prepare|generate|build`.
/.pixiewood/

# `pixiewood prepare` writes subprojects/{glib,fontconfig,gtk}.wrap here and
# meson fetches/builds the actual sources into the same directory.
/subprojects/

# meson native-file written by `meson setup` with this machine's absolute
# paths baked in (cross-file locations, etc.) - not portable, regenerated
# by prepare/setup.
/.buildconfig

# Claude Code's own local session/settings state.
/.claude/
